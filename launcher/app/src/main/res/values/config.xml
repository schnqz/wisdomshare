<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Number of dock slots AND grid columns (4, 5, 6 or 7). -->
    <integer name="columns">4</integer>

    <!-- Dock apps, in order. Package names. Missing packages are skipped.
         YouTube, Nuvio, Spotify, Sportzfy.
         CHECK the last one: app.blaze.spofficial is my best match for Sportzfy. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.nuvio.tv</item>
        <item>com.spotify.tv.android</item>
        <item>app.blaze.spofficial</item>
    </string-array>

    <!-- Never shown in the grid. -->
    <string-array name="hidden_apps">
        <item>com.leanbitlab.ltvL</item>
        <item>com.cvte.tv.launcher.space</item>
    </string-array>

    <!-- Hidden by prefix: factory / production menus must never be opened by accident. -->
    <string-array name="hidden_prefixes">
        <item>com.cvte.factory</item>
        <item>com.cvte.fac</item>
        <item>com.cvte.license</item>
    </string-array>
</resources>
